# 复制为仓库根目录 .env.production，并将所有 CHANGE_ME 替换为真实值。
# 该文件只供 docker-compose.prod.yml 使用。

POSTGRES_USER=interview
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=interview_guide

MINIO_ROOT_USER=interview-storage
MINIO_ROOT_PASSWORD=CHANGE_ME_STORAGE_PASSWORD
APP_STORAGE_BUCKET=interview-guide

# Base64 编码，解码后至少 32 字节。
JWT_SECRET=CHANGE_ME_BASE64_JWT_SECRET
# 部署后必须保持不变，否则已保存的 Provider API Key 将无法解密。
APP_AI_CONFIG_ENCRYPTION_KEY=CHANGE_ME_AI_CONFIG_ENCRYPTION_KEY

# 暂时使用 IP 部署；绑定域名后改成 https://你的域名。
CORS_ALLOWED_ORIGINS=http://129.146.62.132

# 默认文字和向量模型。Key 可以上线后再填写或通过设置页面配置。
SILICONFLOW_API_KEY=
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# 仅语音面试需要。
AI_BAILIAN_API_KEY=

APP_INTERVIEW_ADAPTIVE_AGENT_ENABLED=true
APP_INTERVIEW_CODE_ANALYSIS_WORKER_ENABLED=false
