# ================================
# 必需配置 - 请替换为您的实际密钥
# ================================

# 硅基流动 - 默认 Chat 与 Embedding 服务
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Provider API Key 加密密钥（必填；生产环境请替换为随机长字符串，部署后保持不变）
APP_AI_CONFIG_ENCRYPTION_KEY=change_me_provider_api_key_encryption_key

# ================================
# 文字服务配置
# ================================

# LM Studio 本地 Provider（可选）
# PROVIDER_LMSTUDIO_API_KEY=lm-studio

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6

# DeepSeek (https://platform.deepseek.com/)
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 AI / GLM (https://open.bigmodel.cn/)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# 自定义 OpenAI 兼容 Provider 示例:
# 添加后需在 application.yml 的 app.ai.providers 中配置对应的 base-url 和 model
# PROVIDER_MYPROVIDER_API_KEY=your_api_key_here

# 自适应 Agent 面试平台（默认启用；同时控制 /api/adaptive-agent-interviews REST 接口与 MCP server）
APP_INTERVIEW_ADAPTIVE_AGENT_ENABLED=true
APP_INTERVIEW_ADAPTIVE_AGENT_PLANNER_DEADLINE=60s
APP_INTERVIEW_ADAPTIVE_AGENT_DEADLINE=60s
# MCP server 租户凭证：启用后 MCP 端点默认要求凭证，未配置 credentials 时所有 MCP 调用返回 401
# 在 application.yml 的 app.interview.adaptive-agent.mcp.server.credentials 下按租户配置
# （tenant-id / api-key / scopes，结构示例见 application.yml 注释），api-key 的值建议经环境变量注入
# APP_INTERVIEW_ADAPTIVE_AGENT_MCP_API_KEY=

# 代码分析 Worker 默认关闭；启用后开放 /internal/code-analysis/jobs/** 回调接口。
APP_INTERVIEW_CODE_ANALYSIS_WORKER_ENABLED=false
# 启用 Worker 后必须显式设置为强随机值；缺失时应用快速失败。
# APP_INTERVIEW_CODE_ANALYSIS_WORKER_TOKEN=

# JWT HMAC 密钥（Base64 编码，至少 32 字节；启动时必填）
JWT_SECRET=

# ================================
# 可选配置 - 与根目录 docker-compose.yml 对齐（本地 bootRun 连 compose 起的依赖时勿改）
# ================================

# PostgreSQL（compose 默认：库 interview_guide / 用户 postgres / 密码 password / 映射端口 5432）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis（compose 映射 6379）
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3 兼容存储（compose：MINIO_ROOT_USER/PASSWORD=minioadmin，API 映射 9000）
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interview-guide

# 旧语音面试仍使用阿里云 Qwen Realtime 专用协议；仅启用语音链路时配置
# AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# 语音面试（可选）：多段 STT 合并后再触发面试官；ASR 句间静音阈值（越大越不易句中切开）
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=1600
# APP_VOICE_ASR_SILENCE_MS=1000
